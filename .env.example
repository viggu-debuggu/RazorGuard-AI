# System Configuration
PROJECT_NAME="RazorGuard AI"
ENVIRONMENT="development"
DEBUG=true

# FastAPI Backend Config
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
# Required for docker-compose production mode — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ACCESS_TOKEN_EXPIRE_MINUTES=60


# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/razorguard_db"

# LLM & AI Service Providers
# Supported LLM_PROVIDER: "gemini", "mock"
LLM_PROVIDER="mock"
GEMINI_API_KEY="your_gemini_api_key_here"

# Vector Search Configuration
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Local Storage (for uploaded compliance policy manuals)
LOCAL_STORAGE_PATH="./data/storage"
